<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.meta.title }}</title>
<style>{{ css }}</style>
</head>
<body>
{% set n = namespace(page=1) %}
{% macro folio() %}{% set n.page = n.page + 1 %}<div class="folio folio-left">{{ c.meta.footer }}</div><div class="folio">{{ n.page }}</div>{% endmacro %}
{% macro head(s) %}
  <div class="kicker">{{ s.kicker }}</div>
  <h2>{{ s.title }}</h2>
  {% if s.lead %}<p class="lead">{{ s.lead|rich }}</p>{% endif %}
{% endmacro %}

{# 1. Cover: the big wins come first #}
<section class="page cover">
  <div class="hero">
    <img class="hero-art" src="{{ img(c.cover.hero) }}" alt="Homework">
    <div class="tile hero-logo"><img src="{{ img(c.cover.logo) }}" alt="Naolito"></div>
    <div class="tile hero-tag"><img src="{{ img(c.cover.disney) }}" alt="Disney+"><span>{{ c.cover.tag }}</span></div>
  </div>
  <div class="cover-body">
    <div class="kicker">{{ c.cover.kicker }}</div>
    <h1>{{ c.cover.title|rich }}</h1>
    <div class="logo-strip">
      {% for l in c.cover.logos %}<img src="{{ img(l.img) }}" alt="{{ l.name }}">{% endfor %}
    </div>
    <div class="proof">
      {% for s in c.cover.stats %}
      <div class="stat"><div class="num">{{ s.value }}</div><div class="label">{{ s.label }}</div></div>
      {% endfor %}
    </div>
  </div>
</section>

{# 2. Homework on Disney+ #}
<section class="page film">
  <img class="film-art" src="{{ img(c.film.img) }}" alt="Homework">
  <div class="film-body">
    <div>
      {{ head(c.film) }}
      <p class="note">{{ c.film.note|rich }}</p>
    </div>
    <div class="award">
      <div class="num">{{ c.film.award }}</div>
      <div class="label">{{ c.film.award_label }}</div>
    </div>
  </div>
  {{ folio() }}
</section>

{# 3. Brands #}
<section class="page">
  {{ head(c.brands) }}
  <div class="logo-wall grow">
    {% for l in c.brands.logos %}<div class="tile"><img src="{{ img(l.img) }}" alt="{{ l.name }}"></div>{% endfor %}
  </div>
  {{ folio() }}
</section>

{# 4. Stores and books #}
<section class="page">
  <div class="split grow">
    <figure class="tall">
      <img src="{{ img(c.retail.img) }}" alt="{{ c.retail.caption }}">
      <figcaption>{{ c.retail.caption }}</figcaption>
    </figure>
    <div class="stack">
      {{ head(c.retail) }}
      <div class="mega">{{ c.retail.value }}</div>
      <div class="mega-label">{{ c.retail.label }}</div>
      <div class="book">
        <img src="{{ img(c.retail.book.img) }}" alt="{{ c.retail.book.title }}">
        <div>
          <h3>{{ c.retail.book.title }}</h3>
          <p>{{ c.retail.book.text|rich }}</p>
          <div class="src">{{ c.retail.book.caption }}</div>
        </div>
      </div>
      <p class="note">{{ c.retail.platforms|rich }}</p>
    </div>
  </div>
  {{ folio() }}
</section>

{# 5. Audience #}
<section class="page">
  {{ head(c.audience) }}
  <div class="audience grow">
    <div class="card pink">
      <div class="mega">{{ c.audience.value }}</div>
      <div class="mega-label">{{ c.audience.label }}</div>
      <p class="lead">{{ c.audience.lead|rich }}</p>
    </div>
    <div class="tiles">
      {% for s in c.audience.tiles %}
      <div class="card {{ loop.cycle('mint','sun','cream') }} stat">
        <div class="num">{{ s.value }}</div>
        <div class="label">{{ s.label }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  <p class="src">{{ c.audience.note|rich }}</p>
  {{ folio() }}
</section>

{# 6. Characters #}
<section class="page">
  {{ head(c.characters) }}
  <div class="cast grow">
    {% for ch in c.characters['items'] %}
    <div class="char">
      <img src="{{ img(ch.img) }}" alt="{{ ch.name }}">
      <div class="body"><h3>{{ ch.name }}</h3>{{ ch.desc|rich }}</div>
    </div>
    {% endfor %}
  </div>
  {{ folio() }}
</section>

{# 7. Universe #}
<section class="page">
  {{ head(c.universe) }}
  <div class="gallery art-wall">
    {% for g in c.universe.gallery %}<figure><img src="{{ img(g) }}" alt=""></figure>{% endfor %}
  </div>
  {{ folio() }}
</section>

{# 8. Products: real photos and product concepts #}
<section class="page">
  {{ head(c.products) }}
  <div class="gallery product-wall{{ ' compact' if c.products.gallery|length < 6 }}">
    {% for g in c.products.gallery %}
    <figure><img src="{{ img(g.img) }}" alt="{{ g.caption }}"><figcaption>{{ g.caption }}</figcaption></figure>
    {% endfor %}
  </div>
  {{ folio() }}
</section>

{# 9. The partnership #}
<section class="page">
  <div class="split grow">
    <div class="stack">
      {{ head(c.partner) }}
      <div class="grid g2 partner-cards">
        {% for b in c.partner.cards %}
        <div class="card {{ loop.cycle('mint','pink','sun','cream') }}">
          <h3>{{ b.title }}</h3>
          <p>{{ b.text|rich }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
    <figure class="tall">
      <img src="{{ img(c.partner.img) }}" alt="{{ c.partner.caption }}">
      <figcaption>{{ c.partner.caption }}</figcaption>
    </figure>
  </div>
  {{ folio() }}
</section>

{# 10. Contact #}
<section class="page contact">
  <div class="blob" style="width:140mm;height:140mm;right:-40mm;top:-50mm;background:var(--mint-soft)"></div>
  <img class="logo" src="{{ img(c.cover.logo) }}" alt="Naolito">
  <div class="kicker">{{ c.contact.kicker }}</div>
  <h1>{{ c.contact.title }}</h1>
  <div class="contact-name">{{ c.contact.name }}</div>
  <a class="contact-email" href="mailto:{{ c.contact.email }}">{{ c.contact.email }}</a>
  <div class="contact-web">{{ c.contact.web }}</div>
  {{ folio() }}
</section>

{# 11. Sources #}
<section class="page">
  {{ head(c.sources) }}
  <ul class="source-notes">
    {% for t in c.sources.notes %}<li>{{ t|rich }}</li>{% endfor %}
  </ul>
  <ol class="sources">
    {% for s in c.sources['items'] %}
    <li><strong>{{ s.label }}</strong>{% if s.url %}<br><a href="{{ s.url }}">{{ s.url }}</a>{% endif %}</li>
    {% endfor %}
  </ol>
  {{ folio() }}
</section>
</body>
</html>
